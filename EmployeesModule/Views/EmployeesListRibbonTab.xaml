<RibbonTab x:Class="EmployeesModule.Views.EmployeesListRibbonTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:EmployeesModule.Views"
             mc:Ignorable="d" 
             Header="Pracownicy"
             xmlns:prism="http://prismlibrary.com/"
             ContextualTabGroupHeader="Pracownicy"
             prism:ViewModelLocator.AutoWireViewModel="False">
    <RibbonGroup>
        <RibbonButton LargeImageSource="pack://application:,,,/PrismCoreDemo;component/Images/add.png" Label="Dodaj" Command="{Binding AddEmployeeCommand}"/>
        <RibbonButton LargeImageSource="pack://application:,,,/PrismCoreDemo;component/Images/remove.png" Label="Usuń" Command="{Binding RemoveEmployeeCommand}" />
        <RibbonButton LargeImageSource="pack://application:,,,/PrismCoreDemo;component/Images/edit.png" Label="Edytuj" Command="{Binding EditEmployeeCommand}" />
        <RibbonButton LargeImageSource="pack://application:,,,/PrismCoreDemo;component/Images/close.png" Label="Zamknij" Command="{Binding CloseViewCommand}" />
    </RibbonGroup>
</RibbonTab>
