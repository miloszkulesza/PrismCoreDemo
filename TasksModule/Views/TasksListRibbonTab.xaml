<RibbonTab x:Class="TasksModule.Views.TasksListRibbonTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:TasksModule.Views"
             mc:Ignorable="d" 
             Header="Lista zadań"
             ContextualTabGroupHeader="Zadania"
             xmlns:prism="http://prismlibrary.com/"
             prism:ViewModelLocator.AutoWireViewModel="False">
    <RibbonGroup>
        <RibbonButton LargeImageSource="pack://application:,,,/PrismCoreDemo;component/Images/add.png" Label="Dodaj" Command="{Binding AddTaskCommand}"/>
        <RibbonButton LargeImageSource="pack://application:,,,/PrismCoreDemo;component/Images/remove.png" Label="Usuń" Command="{Binding RemoveTaskCommand}" />
        <RibbonButton LargeImageSource="pack://application:,,,/PrismCoreDemo;component/Images/edit.png" Label="Edytuj" Command="{Binding EditTaskCommand}" />
        <RibbonButton LargeImageSource="pack://application:,,,/PrismCoreDemo;component/Images/close.png" Label="Zamknij" Command="{Binding CloseViewCommand}" />
    </RibbonGroup>
</RibbonTab>
